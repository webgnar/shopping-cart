; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="shopping cart"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="uid://d0rbvnae1syfi"

[autoload]

Console="*res://scenes/ui/console.tscn"
Net="*res://scenes/net/net_session.tscn"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.05

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=30
jolt_physics_3d/simulation/position_steps=8
jolt_physics_3d/simulation/penetration_slop=0.002
jolt_physics_3d/limits/world_boundary_shape_size=20000.0
jolt_physics_3d/limits/max_angular_velocity=120.0
3d/default_linear_damp=0.02
3d/default_angular_damp=0.05

[rendering]

rendering_device/driver.windows="d3d12"
