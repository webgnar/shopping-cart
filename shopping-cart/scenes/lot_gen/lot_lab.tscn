[ext_resource type="Material" path="res://assets/parking_lot/materials/sidewalk.tres" id="4_sidewalk"]

[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Menlo", "Consolas", "DejaVu Sans Mono", "monospace")

[sub_resource type="Theme" id="Theme_lab"]
