size = Vector2(600, 600)

[node name="LotLab" type="Node3D" node_paths=PackedStringArray("generator", "pivot", "camera", "settings_panel", "stats_panel")]
script = ExtResource("1_lab")
generator = NodePath("LotGenerator")
pivot = NodePath("Pivot")
camera = NodePath("Pivot/Camera")
settings_panel = NodePath("UI/Panel")
stats_panel = NodePath("UI/StatsPanel")

[node name="Environment" parent="." instance=ExtResource("2_env")]

[node name="Ground" type="MeshInstance3D" parent="."]
