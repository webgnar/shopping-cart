[node name="StartHere" type="Button" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Start the timeline at this year, so it runs 30 more years on from here and you can watch your repairs age. Press again to go back to the road's own years."
toggle_mode = true
text = "Start timeline here"

[node name="RepairsHeader" type="Label" parent="Panel/Scroll/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.62, 0.25, 1)
text = "REPAIRS (tick to do one at this year, untick to undo it)"

[node name="Repair0" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pour hot rubberised sealant into the open cracks and overband it. Stops water and stops them opening, for about 6 years."
text = "Fill cracks"

[node name="Repair1" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Shovel cold mix into each pothole and roll it with the truck. Quick and cheap; it usually ravels out again."
text = "Fill potholes (throw and roll)"

[node name="Repair2" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Saw-cut a rectangle round each fatigue area and pothole, dig it out and replace it full depth. The cut edges crack later."
text = "Heavy patch (saw cut)"

[node name="Repair3" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Squeegee black sealer over a few of the roughest spots. Flat black, so only the texture under it shows; it greys and wears off the wheel paths in a few years, and the cracks show back through."
text = "Spot sealcoat"

[node name="Repair4" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Cold plane the top and pave a new asphalt layer. Resets the surface and edges; old cracks reflect through in a few years."
text = "Mill and overlay"

[node name="Repair5" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Repaint the stall lines: fresh paint over everything, patches and sealcoat included. It wears again from here."
text = "Repaint stripes"

[node name="ConditionsHeader" type="Label" parent="Panel/Scroll/Box"]
