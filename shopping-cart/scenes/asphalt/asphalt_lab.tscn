[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -330.0
grow_horizontal = 0
grow_vertical = 2
theme = SubResource("Theme_panel")
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Scroll" type="ScrollContainer" parent="Panel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Panel/Scroll/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Asphalt lab: a 10 x 10 m road section"

[node name="Subtitle" type="Label" parent="Panel/Scroll/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.65, 0.68, 0.72, 1)
autowrap_mode = 3
text = "Colour map left, height map right. Traffic runs up and down; two lanes, gravel shoulders."

[node name="YearLabel" type="Label" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Year 0.0"

[node name="Timeline" type="HSlider" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
max_value = 40.0
step = 0.1

[node name="PlayRow" type="HBoxContainer" parent="Panel/Scroll/Box"]
layout_mode = 2

[node name="PlayButton" type="Button" parent="Panel/Scroll/Box/PlayRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "Play"

[node name="View" type="OptionButton" parent="Panel/Scroll/Box/PlayRow"]
layout_mode = 2
size_flags_horizontal = 3
selected = 2
item_count = 4
popup/item_0/text = "Colour"
popup/item_0/id = 0
popup/item_1/text = "Height"
popup/item_1/id = 1
popup/item_2/text = "Both"
popup/item_2/id = 2
popup/item_3/text = "Colour + relief"
popup/item_3/id = 3

[node name="RepairsHeader" type="Label" parent="Panel/Scroll/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.62, 0.25, 1)
text = "REPAIRS (done now, kept when you scrub)"

[node name="Repair0" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
tooltip_text = "Pour hot rubberised sealant into the open cracks and overband it. Stops water and stops them opening, for about 6 years."
text = "Fill cracks"

[node name="Repair1" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
tooltip_text = "Shovel cold mix into each pothole and roll it with the truck. Quick and cheap; it usually ravels out again."
text = "Fill potholes (throw and roll)"

[node name="Repair2" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
tooltip_text = "Saw-cut a rectangle round each fatigue area and pothole, dig it out and replace it full depth. The cut edges crack later."
text = "Heavy patch (saw cut)"

[node name="Repair3" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
tooltip_text = "Spray bitumen and roll in a layer of chips over the whole road. Seals it, but the old cracks reflect back through soon."
text = "Surface seal (chip seal)"

[node name="Repair4" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
tooltip_text = "Cold plane the top and pave a new asphalt layer. Resets the surface and edges; old cracks reflect through in a few years."
text = "Mill and overlay"

[node name="AutoMaintain" type="CheckBox" parent="Panel/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "A road crew repairs on its own: fills potholes, fills cracks once they open, patches fatigue areas, overlays when the road is beyond patching."
text = "Road crew repairs on its own"

[node name="ClearRepairs" type="Button" parent="Panel/Scroll/Box"]
layout_mode = 2
text = "Forget my repairs"

[node name="ConditionsHeader" type="Label" parent="Panel/Scroll/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.62, 0.25, 1)
text = "CONDITIONS (replays from year 0)"

