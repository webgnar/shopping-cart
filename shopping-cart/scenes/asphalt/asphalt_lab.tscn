OptionButton/styles/hover = SubResource("StyleBoxFlat_button_hover")
OptionButton/styles/pressed = SubResource("StyleBoxFlat_button_hover")

[node name="AsphaltLab" type="Control" node_paths=PackedStringArray("sim", "color_view", "height_view", "relief_view")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lab")
sim = NodePath("Sim")
color_view = NodePath("Views/ColorView")
height_view = NodePath("Views/HeightView")
relief_view = NodePath("Views/ReliefView")

[node name="Sim" type="Node" parent="."]
script = ExtResource("2_sim")

[node name="ColorViewport" type="SubViewport" parent="."]
disable_3d = true
size = Vector2i(2048, 2048)
render_target_update_mode = 4

[node name="Base" type="ColorRect" parent="ColorViewport"]
material = SubResource("ShaderMaterial_color")
offset_right = 2048.0
offset_bottom = 2048.0
mouse_filter = 2

[node name="Damage" type="Node2D" parent="ColorViewport" node_paths=PackedStringArray("sim", "base")]
texture_filter = 4
texture_repeat = 2
script = ExtResource("3_canvas")
sim = NodePath("../../Sim")
mode = 0
base = NodePath("../Base")
grain = ExtResource("5_grain")
patch_texture = ExtResource("6_hotmix")
fill_texture = ExtResource("7_coldmix")
sealant_texture = ExtResource("8_sealant")

[node name="HeightViewport" type="SubViewport" parent="."]
disable_3d = true
size = Vector2i(2048, 2048)
render_target_update_mode = 4

[node name="Base" type="ColorRect" parent="HeightViewport"]
material = SubResource("ShaderMaterial_height")
offset_right = 2048.0
offset_bottom = 2048.0
mouse_filter = 2

[node name="Damage" type="Node2D" parent="HeightViewport" node_paths=PackedStringArray("sim", "base")]
texture_repeat = 2
script = ExtResource("3_canvas")
sim = NodePath("../../Sim")
mode = 1
base = NodePath("../Base")
grain = ExtResource("5_grain")

