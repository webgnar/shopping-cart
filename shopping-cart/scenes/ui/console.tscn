[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/console.gd" id="1_cons"]
[ext_resource type="Theme" path="res://assets/ui/road_sign_theme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Consolas", "Menlo", "DejaVu Sans Mono", "Monospace")

[sub_resource type="SystemFont" id="SystemFont_mono_bold"]
font_names = PackedStringArray("Consolas", "Menlo", "DejaVu Sans Mono", "Monospace")
font_weight = 700

[node name="Console" type="CanvasLayer"]
process_mode = 3
layer = 100
visible = false
script = ExtResource("1_cons")
destinations = Dictionary[String, String]({
"plot": "res://scenes/levels/parking_lot.tscn",
"garage": "res://scenes/levels/parking_garage.tscn",
"market": "res://scenes/levels/supermarket.tscn",
"hill": "res://scenes/levels/sf_hill.tscn",
"coast": "res://scenes/levels/coast_highway.tscn",
"downhill": "res://scenes/levels/downhill_highway.tscn",
"asphalt": "res://scenes/levels/asphalt_lot.tscn",
"ball": "res://scenes/levels/cart_ball_arena.tscn",
"collect": "res://scenes/levels/cart_collect_lot.tscn",
"chain": "res://scenes/levels/chain_lot.tscn",
"lotgen": "res://scenes/levels/generated_lot.tscn",
"lotlab": "res://scenes/lot_gen/lot_lab.tscn",
"sandbox": "res://scenes/levels/lot90.tscn"
})

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
anchor_bottom = 0.4
grow_horizontal = 2
theme = ExtResource("2_theme")
theme_type_variation = &"MessageSignPanel"

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Output" type="RichTextLabel" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
theme_override_colors/default_color = Color(1, 0.71, 0.18, 1)
theme_override_fonts/normal_font = SubResource("SystemFont_mono")
theme_override_fonts/bold_font = SubResource("SystemFont_mono_bold")
theme_override_font_sizes/normal_font_size = 15
theme_override_font_sizes/bold_font_size = 15
bbcode_enabled = true
scroll_following = true
selection_enabled = true

[node name="Input" type="LineEdit" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MessageSignInput"
theme_override_fonts/font = SubResource("SystemFont_mono")
theme_override_font_sizes/font_size = 15
placeholder_text = "type help for commands"
keep_editing_on_text_submit = true
caret_blink = true

[connection signal="text_submitted" from="Panel/VBox/Input" to="." method="_on_input_submitted"]
