size_flags_horizontal = 4
max_value = 400.0
step = 0.0
fill_mode = 3
texture_under = SubResource("GradientTexture2D_pushdim")
texture_progress = SubResource("GradientTexture2D_push")

[node name="Zero" type="ColorRect" parent="Screen/Controls/Drive/RightBar/Lines"]
