layout_mode = 2
theme_override_constants/separation = 3

[node name="Plaque" type="PanelContainer" parent="Screen/Controls/Drive/RightBar/Lines"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_styles/panel = SubResource("Style_plaque")

[node name="Caption" type="Label" parent="Screen/Controls/Drive/RightBar/Lines/Plaque"]
