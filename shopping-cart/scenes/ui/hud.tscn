theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 10
text = "RIGHT"
horizontal_alignment = 1

[node name="RightPush" type="TextureProgressBar" parent="Screen/Controls/Drive/RightBar/Lines"]
