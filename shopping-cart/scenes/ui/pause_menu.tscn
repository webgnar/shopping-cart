[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://assets/ui/road_sign_theme.tres" id="2_theme"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 90
visible = false
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Paused"
horizontal_alignment = 1

[node name="PlacesLabel" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"SignHeading"
text = "PLACES"

[node name="Places" type="GridContainer" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="CommandsLabel" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"SignHeading"
text = "COMMANDS"

[node name="Commands" type="GridContainer" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="ButtonTemplate" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(136, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 17

[node name="Gap" type="Control" parent="Center/Panel/Rows"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="BottomRow" type="HBoxContainer" parent="Center/Panel/Rows"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ResumeButton" type="Button" parent="Center/Panel/Rows/BottomRow"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Resume (Esc)"

[node name="QuitButton" type="Button" parent="Center/Panel/Rows/BottomRow"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StopButton"
theme_override_font_sizes/font_size = 18
text = "Quit game"

[connection signal="pressed" from="Center/Panel/Rows/BottomRow/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Center/Panel/Rows/BottomRow/QuitButton" to="." method="_on_quit_pressed"]
