class_name CartTuningExport
extends RefCounted
## Writes the cart's settings from the editor into tuning/cart_tuning.json and mobile/cart_tuning.js, so the
## mobile web game drives like the Godot one. The Godot game itself never reads these files: the cart scene
## (scenes/cart/cart.tscn) and the floor materials (assets/physics/*.tres) are the source of truth.
## Run it from the editor (tools/export_cart_tuning.gd, File > Run) or headless:
##   godot --headless -s res://tools/export_cart_tuning_cli.gd

const CART_SCENE := "res://scenes/cart/cart.tscn"
const JSON_PATH := "res://tuning/cart_tuning.json"
const ABOUT := "Cart feel for the mobile web game (mobile/), copied from the Godot cart scene (scenes/cart/cart.tscn) and floor materials (assets/physics/*.tres) by tools/export_cart_tuning.gd. Do not edit by hand: change the cart in the Godot editor and export again. Units: kg, N, m/s, rad, N*m."
const FLOORS := {"tile": "res://assets/physics/tile.tres", "asphalt": "res://assets/physics/asphalt.tres"}


## The tuning dictionary as the scene and materials have it now, keeping the JSON's notes and key order.
static func current() -> Dictionary:
	var out := {}
	var old: Variant = JSON.parse_string(FileAccess.get_file_as_string(JSON_PATH)) if FileAccess.file_exists(JSON_PATH) else null
	if typeof(old) == TYPE_DICTIONARY:
		out = old
	var cart: ShoppingCart = (load(CART_SCENE) as PackedScene).instantiate()
	var t := cart.tuning()
	cart.free()
	var floors := {}
	for k in FLOORS:
		floors[k] = (load(FLOORS[k]) as PhysicsMaterial).friction
	t["floor_friction"] = floors
	for k in t:
		out[k] = _tidy(t[k])
	# Drop settings the cart no longer has (and their notes), so the mobile game never reads stale ones.
	for k in out.keys():
		var base: String = k.trim_prefix("_")
		if k != "_about" and not t.has(base):
			out.erase(k)
	out["_about"] = ABOUT
	return out


## Physics values are stored as 32-bit floats (0.6 reads back as 0.6000000238); round them for the file.
static func _tidy(v: Variant) -> Variant:
	match typeof(v):
		TYPE_FLOAT:
			return snappedf(v, 0.000001)
		TYPE_ARRAY:
			return (v as Array).map(_tidy)
		TYPE_DICTIONARY:
			var d := {}
			for k in v:
				d[k] = _tidy(v[k])
			return d
	return v


## Writes both files and returns the JSON text.
static func export() -> String:
	var text := JSON.stringify(current(), "  ", false) + "\n"
	var f := FileAccess.open(JSON_PATH, FileAccess.WRITE)
	f.store_string(text)
	f.close()
	var js_path := ProjectSettings.globalize_path("res://").path_join("../mobile/cart_tuning.js").simplify_path()
	var js := FileAccess.open(js_path, FileAccess.WRITE)
	if js:
		js.store_string("// Generated by shopping-cart/tools/export_cart_tuning.gd from the Godot cart scene. Change the cart in Godot, not here.\n")
		js.store_string("window.CART_TUNING = " + text.strip_edges() + ";\n")
		js.close()
	print("CART TUNING written to ", ProjectSettings.globalize_path(JSON_PATH), " and ", js_path)
	return text
